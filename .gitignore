.DS_Store
public/

# Debris from research runs. A scraped copy of healthcareitconnect.com got
# committed as a file literally called `text` on 2026-08-25, swept up by
# `git add -A` from a redirect that lost its filename. These are the shapes
# that keep happening.
/text
/out
/tmp
*.tmp
*.orig

# Conditional-request bodies, kept so an unchanged board costs a 304 instead
# of a full fetch. Local only and rebuilt on demand - a CI runner is a fresh
# machine each time, so this does nothing there unless the workflow restores
# it. Never committed: it is other people's page content, and megabytes of it.
/data/http_cache/
